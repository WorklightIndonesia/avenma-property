# Nilai di file ini adalah nilai production (Hostinger).
# Untuk lokal, timpa tujuh baris ini di .env hasil salinan:
#   APP_ENV=local
#   APP_DEBUG=true
#   APP_URL=http://127.0.0.1:8000
#   DB_CONNECTION=sqlite
#   SESSION_SECURE_COOKIE=false
#   MAIL_MAILER=log
#   LOG_LEVEL=debug
# SESSION_SECURE_COOKIE=true di atas HTTP membuat cookie sesi tidak pernah
# tersimpan, jadi login lokal gagal tanpa baris pertama tadi.

APP_NAME="Avenma Property"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-anda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# hPanel > Databases. Isi keempatnya; sqlite hanya untuk lokal.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Tidak ada worker di shared hosting. Lihat README, Deploy ke Hostinger.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

# Lupa Password memakai ini. Tanpa kredensial benar, email tidak terkirim.
# Host mengikuti tempat kotak suratnya: Google Workspace -> smtp.gmail.com:587
# dengan App Password 16 karakter; email Hostinger -> smtp.hostinger.com:465
# dengan MAIL_SCHEME=smtps.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=admin.avenmaproperti@apfianigroup.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="admin.avenmaproperti@apfianigroup.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Dibaca AdminSeeder saat deploy: minimal 8 karakter, huruf besar dan kecil,
# angka, dan simbol. Kosongkan lagi setelah akun dibuat.
ADMIN_PASSWORD=
